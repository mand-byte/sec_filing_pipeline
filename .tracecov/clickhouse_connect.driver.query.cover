               # non-quoted, actual comment string, so return nothing to remove the comment
>>>>>>         if match.group(2):
>>>>>>             return ''
               # Otherwise we've actually captured a quoted string, so return it
>>>>>>         return match.group(1)
       
    1:     return comment_re.sub(replacer, sql)
       
       
