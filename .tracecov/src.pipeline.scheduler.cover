    1: from __future__ import annotations
       
    1: from datetime import datetime, timezone
    1: import traceback
    1: from typing import Any, Callable, Iterable, Protocol
       
    1: from apscheduler.schedulers.blocking import BlockingScheduler
       
       
    1: ROUTE_ORDER = ("issuer", "owner", "holding")
       
       
    2: class RouterContext(Protocol):
    1:     run_id: str
    1:     route: str
    1:     repo: Any
       
       
    2: class Router(Protocol):
    1:     name: str
       
    1:     def run(self, *, security: Any, context: RouterContext) -> None: ...
       
       
    1: def ordered_routers(router_map: dict[str, object]) -> list[object]:
>>>>>>     return [router_map[route_name] for route_name in ROUTE_ORDER if route_name in router_map]
       
       
    6: def run_single_tick(
    1:     run_id: str,
    1:     securities: Iterable[Any],
    1:     routers: Iterable[Router],
    1:     repo: Any,
    1: ) -> None:
>>>>>>     for security in securities:
>>>>>>         for router in routers:
>>>>>>             try:
>>>>>>                 router.run(
>>>>>>                     security=security,
>>>>>>                     context={
>>>>>>                         "run_id": run_id,
>>>>>>                         "route": getattr(router, "name", router.__class__.__name__),
>>>>>>                         "repo": repo,
                           },
                       )
>>>>>>             except Exception as exc:
>>>>>>                 try:
>>>>>>                     repo.write_log(
>>>>>>                         run_id=run_id,
>>>>>>                         route=getattr(router, "name", router.__class__.__name__),
>>>>>>                         cik=getattr(security, "cik", None),
>>>>>>                         stage="extract",
>>>>>>                         level="ERROR",
>>>>>>                         message="router failed",
>>>>>>                         error_type=exc.__class__.__name__,
>>>>>>                         error_detail="".join(traceback.TracebackException.from_exception(exc).format()).strip(),
                           )
>>>>>>                 except Exception:
>>>>>>                     pass
>>>>>>                 continue
       
       
    4: def build_blocking_scheduler(
    1:     interval_minutes: int,
    1:     tick_callable: Callable[[], None],
    1: ) -> BlockingScheduler:
>>>>>>     scheduler = BlockingScheduler()
>>>>>>     scheduler.add_job(
>>>>>>         tick_callable,
>>>>>>         trigger="interval",
>>>>>>         minutes=interval_minutes,
>>>>>>         id="phase1-tick",
           )
>>>>>>     return scheduler
       
       
    1: def make_run_id() -> str:
>>>>>>     return datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
