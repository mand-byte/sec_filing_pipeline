    1: def test_build_bundles_from_provider_emits_form4_transaction_rows(monkeypatch) -> None:
    2:     envelope = FilingEnvelope(
    1:         accession_no="0000000000-24-000100",
    1:         cik="0000789019",
    1:         form_type="4",
    1:         accepted_at=datetime(2024, 5, 1, tzinfo=timezone.utc),
    2:         filing=FakeForm4Filing(
