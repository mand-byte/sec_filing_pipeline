    1:                 FakeTransaction(shares=-50.0, price_per_share=11.0, shares_owned_following_transaction=950.0),
                   ],
    1:             [
    1:                 {"UnderlyingShares": 500.0, "ExercisePrice": 7.5},
    1:                 {"UnderlyingShares": 250.0, "ExercisePrice": 6.25},
                   ],
    1:             sections=["Remarks\nThe reporting person is a director and this was a buy transaction."],
               ),
           )
       
    2:     monkeypatch.setattr(
    1:         cli_module,
    1:         "fetch_filings_for_security",
    2:         lambda *, security, route, start_accepted_at: [envelope],
           )
       
    1:     repo = FakeRepo()
    1:     security = SimpleNamespace(cik="0000789019", ticker="MSFT")
    2:     bundles = cli_module._build_bundles_from_provider(
    1:         security=security,
    1:         route="owner",
    1:         start_accepted_at=datetime(2024, 4, 1, tzinfo=timezone.utc),
    1:         repo=repo,
    1:         run_id="run-owner-1",
           )
       
    1:     assert len(bundles) == 1
    1:     bundle = bundles[0]
   13:     facts = {(fact.field_name, fact.subject_key): fact.value_numeric for fact in bundle.facts}
    1:     assert facts[("shares_acquired_or_disposed", "txn:1")] == 100.0
    1:     assert facts[("shares_acquired_or_disposed", "txn:2")] == -50.0
    1:     assert facts[("transaction_price_per_share", "txn:1")] == 10.5
    1:     assert facts[("transaction_price_per_share", "txn:2")] == 11.0
    1:     assert facts[("shares_owned_following_txn", "txn:1")] == 1000.0
    1:     assert facts[("shares_owned_following_txn", "txn:2")] == 950.0
    1:     assert facts[("derivative_underlying_shares", "dtxn:1")] == 500.0
    1:     assert facts[("derivative_underlying_shares", "dtxn:2")] == 250.0
    1:     assert facts[("exercise_or_conversion_price", "dtxn:1")] == 7.5
    1:     assert facts[("exercise_or_conversion_price", "dtxn:2")] == 6.25
   13:     text_facts = {(fact.field_name, fact.subject_key): fact.value_text for fact in bundle.facts if fact.value_text is not None}
    1:     assert text_facts[("insider_transaction_quant", "document")] == "buy"
    1:     assert text_facts[("insider_role_ownership_structure_quant", "document")] == "director"
       
   13:     evidence_keys = {(e.field_name, e.subject_key) for e in bundle.evidences}
    1:     assert ("transaction_price_per_share", "txn:1") in evidence_keys
    1:     assert ("shares_owned_following_txn", "txn:2") in evidence_keys
    1:     assert ("derivative_underlying_shares", "dtxn:1") in evidence_keys
    1:     assert ("exercise_or_conversion_price", "dtxn:2") in evidence_keys
    1:     assert repo.logs == []
       
       
