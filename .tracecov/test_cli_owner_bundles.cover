    1:     assert repo.logs[-1]["error_type"] == "NO_OWNER_ROWS_EXTRACTED"
       
       
    1: def test_classify_form_family_normalizes_schedule_aliases() -> None:
    1:     assert classify_form_family("SC 13G") == "13G"
    1:     assert classify_form_family("SC 13D/A") == "13D"
    1:     assert classify_form_family("SCHEDULE 13D") == "13D"
    1:     assert classify_form_family("SCHEDULE 13G/A") == "13G"
