>>>>>>                         accession_no=bundle.filing.accession_no,
>>>>>>                         cik=cik,
>>>>>>                         accepted_at=bundle.filing.accepted_at,
>>>>>>                         status="completed",
                           )
>>>>>>                     processed_bundles.append(bundle)
>>>>>>                     _safe_write_log(
>>>>>>                         self.repo,
>>>>>>                         run_id=run_id,
>>>>>>                         route=route,
>>>>>>                         cik=cik,
>>>>>>                         accession_no=bundle.filing.accession_no,
>>>>>>                         stage="persist",
