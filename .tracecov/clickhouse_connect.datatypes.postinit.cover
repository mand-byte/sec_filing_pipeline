    1: from clickhouse_connect.datatypes import registry, dynamic, geometric
    1: from clickhouse_connect.datatypes.base import TypeDef
    1: from clickhouse_connect.datatypes.container import Map
       
    1: dynamic.STRING_DATA_TYPE = registry.get_from_name('String')
       
       # Build a private Map(String, String) for JSON shared data decoding.
       # We must NOT reuse the cached registry instance because we replace
       # value_type with SharedDataString (reads raw bytes, encoding=None).
       # Mutating the cached instance would break all normal Map(String, String) columns.
    1: _shared_map = Map(TypeDef((), (), ('String', 'String')))
    1: _shared_map.value_type = dynamic.SharedDataString(dynamic.STRING_DATA_TYPE.type_def)
    1: dynamic.SHARED_DATA_TYPE = _shared_map
       
    1: dynamic.SHARED_VARIANT_TYPE = dynamic.SharedVariant(dynamic.STRING_DATA_TYPE.type_def)
       
    1: point = 'Tuple(Float64, Float64)'
    1: ring = f'Array({point})'
    1: polygon = f'Array({ring})'
    1: multi_polygon = f'Array({polygon})'
       
    1: geometric.POINT_DATA_TYPE = registry.get_from_name(point)
    1: geometric.RING_DATA_TYPE = registry.get_from_name(ring)
    1: geometric.POLYGON_DATA_TYPE = registry.get_from_name(polygon)
    1: geometric.MULTI_POLYGON_DATA_TYPE = registry.get_from_name(multi_polygon)
