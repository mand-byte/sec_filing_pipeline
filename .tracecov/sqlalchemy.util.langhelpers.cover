>>>>>>             for _ in (
>>>>>>                 c.__subclasses__()
>>>>>>                 if not issubclass(c, type)
>>>>>>                 else c.__subclasses__(c)
                   )
>>>>>>             if _ not in hier
               ]:
>>>>>>             process.append(s)
>>>>>>             hier.add(s)
>>>>>>     return list(hier)
       
       
