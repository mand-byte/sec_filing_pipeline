    1: from __future__ import annotations
       
    1: from dataclasses import dataclass
    1: from typing import Literal, Protocol, TypedDict
       
       
    1: ReviewReason = Literal["first_seen_for_issuer", "first_seen_template", "outlier_vs_history"]
       
       
    2: class ReviewGateDecision(TypedDict):
    1:     decision: Literal["auto_accept", "needs_review"]
    1:     reason: ReviewReason | None
    1:     priority: str | None
       
       
    2: class ReviewStats(Protocol):
    1:     def issuer_field_count(self, cik: str, route: str, field_name: str) -> int: ...
       
    1:     def template_field_count(self, template_hash: str, route: str, field_name: str) -> int: ...
       
    1:     def zscore(self, value_numeric: float, route: str, field_name: str) -> float | None: ...
       
       
    3: @dataclass(frozen=True)
    2: class ReviewGateInput:
    1:     cik: str
    1:     route: str
    1:     field_name: str
    1:     template_hash: str | None
    1:     value_numeric: float | int | None
       
       
    1: REVIEW_PRIORITY_BY_REASON: dict[ReviewReason, str] = {
    1:     "first_seen_for_issuer": "high",
    1:     "first_seen_template": "medium",
    1:     "outlier_vs_history": "high",
       }
       
       
    5: def evaluate_review_gate(
           *,
    1:     candidate: ReviewGateInput,
    1:     stats: ReviewStats,
    2:     outlier_zscore_threshold: float = 3.0,
    1: ) -> ReviewGateDecision:
>>>>>>     if stats.issuer_field_count(candidate.cik, candidate.route, candidate.field_name) <= 0:
>>>>>>         reason: ReviewReason = "first_seen_for_issuer"
>>>>>>         return {
>>>>>>             "decision": "needs_review",
>>>>>>             "reason": reason,
>>>>>>             "priority": REVIEW_PRIORITY_BY_REASON[reason],
               }
       
>>>>>>     if candidate.template_hash and stats.template_field_count(
>>>>>>         candidate.template_hash,
>>>>>>         candidate.route,
>>>>>>         candidate.field_name,
>>>>>>     ) <= 0:
>>>>>>         reason = "first_seen_template"
>>>>>>         return {
>>>>>>             "decision": "needs_review",
>>>>>>             "reason": reason,
>>>>>>             "priority": REVIEW_PRIORITY_BY_REASON[reason],
               }
       
>>>>>>     if isinstance(candidate.value_numeric, (int, float)) and not isinstance(candidate.value_numeric, bool):
>>>>>>         z_score = stats.zscore(float(candidate.value_numeric), candidate.route, candidate.field_name)
>>>>>>         if isinstance(z_score, (int, float)) and not isinstance(z_score, bool) and z_score > outlier_zscore_threshold:
>>>>>>             reason = "outlier_vs_history"
>>>>>>             return {
>>>>>>                 "decision": "needs_review",
>>>>>>                 "reason": reason,
>>>>>>                 "priority": REVIEW_PRIORITY_BY_REASON[reason],
                   }
       
>>>>>>     return {
>>>>>>         "decision": "auto_accept",
>>>>>>         "reason": None,
>>>>>>         "priority": None,
           }
