    1: """
       _constants
       ======
       
       Constants relevant for the Python implementation.
       """
       
    1: from __future__ import annotations
       
    1: import platform
    1: import sys
    1: import sysconfig
       
    1: IS64 = sys.maxsize > 2**32
       
    1: PY312 = sys.version_info >= (3, 12)
    1: PY314 = sys.version_info >= (3, 14)
    1: PYPY = platform.python_implementation() == "PyPy"
    1: WASM = (sys.platform == "emscripten") or (platform.machine() in ["wasm32", "wasm64"])
    1: ISMUSL = "musl" in (sysconfig.get_config_var("HOST_GNU_TYPE") or "")
       # the refcount for self in a chained __setitem__/.(i)loc indexing/method call
    1: REF_COUNT = 2 if PY314 else 3
    1: REF_COUNT_IDX = 2
    1: REF_COUNT_METHOD = 1 if PY314 else 2
    1: CHAINED_WARNING_DISABLED = PYPY
       
       
    1: __all__ = [
           "IS64",
           "ISMUSL",
           "PY312",
           "PY314",
           "PYPY",
           "WASM",
       ]
