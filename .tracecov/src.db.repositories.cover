    1: def _normalize_to_utc(value: datetime) -> datetime:
>>>>>>     if value.tzinfo is None:
>>>>>>         return value.replace(tzinfo=timezone.utc)
       
>>>>>>     return value.astimezone(timezone.utc)
       
       
    2: class PipelineRepository:
    1:     def __init__(self, session: Session):
>>>>>>         self.session = session
       
    1:     def _is_postgresql(self) -> bool:
>>>>>>         bind = self.session.get_bind()
>>>>>>         return bind is not None and bind.dialect.name == "postgresql"
       
    1:     def _commit_with_rollback(self) -> None:
>>>>>>         try:
>>>>>>             self.session.commit()
>>>>>>         except Exception:
>>>>>>             self.session.rollback()
>>>>>>             raise
       
    1:     def get_route_watermark(self, cik: str, route: RouteName) -> datetime | None:
>>>>>>         row = self.session.scalar(
>>>>>>             select(RouteWatermark).where(
