PG_DSN=postgresql+psycopg://user:password@127.0.0.1:5432/sec_filing
CH_DSN=clickhouse://user:password@127.0.0.1:8123/quant_data
SEC_UNIVERSE_TABLE=data_quant.us_stock_universe
START_DATE=2014-01-01
SCHEDULER_INTERVAL_MINUTES=60
OFFLINE_ARTIFACTS_DIR=artifacts
WRITE_OFFLINE_ARTIFACTS=true
EDGAR_IDENTITY="Example Company ops@example.com"
# Filing persistence mode for downloaded payloads (.nc); processing fetches are independent of this switch.
# 0 = do not persist filing payloads
# 1 = persist filing payloads to local ~/.edgar/filings (or EDGAR_LOCAL_DATA_DIR)
# 2 = persist filing payloads to cloud storage via EDGAR_CLOUD_*
EDGAR_DOWNLOAD_FILINGS_FLAG=0
# Optional: override only if you do NOT want the default ~/.edgar for local mode (flag=1)
# EDGAR_LOCAL_DATA_DIR=~/.edgar
# Optional cloud filing storage destination for cloud mode (flag=2)
# EDGAR_CLOUD_URI=s3://sec-filing/
# EDGAR_CLOUD_ENDPOINT_URL=http://127.0.0.1:9000
# EDGAR_CLOUD_ACCESS_ID=minio
# EDGAR_CLOUD_ACCESS_KEY=minio123
TEXT_NORMALIZER_MODE=unavailable
# TEXT_NORMALIZER_BASE_URL=https://example.test/v1
# TEXT_NORMALIZER_MODEL=gpt-5.4
# TEXT_NORMALIZER_API_KEY=secret
# TEXT_NORMALIZER_TIMEOUT_SECONDS=30

# Legacy compatibility is still supported during migration:
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_DB=sec_filing
# POSTGRES_USER=user
# POSTGRES_PASSWORD=password
# CLICKHOUSE_HOST=127.0.0.1
# CLICKHOUSE_PORT=8123
# CLICKHOUSE_DATABASE=quant_data
# CLICKHOUSE_USER=user
# CLICKHOUSE_PASSWORD=password
# LLM_BASE_URL=https://example.test/v1
# LLM_MODEL_NAME=gpt-5.4
# LLM_AUTH_KEY=secret
# LLM_TIMEOUT_SECONDS=30
